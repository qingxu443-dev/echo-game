display_name_zh = "第一关 · 遗迹宝箱"
tactical_hint_zh = "敌人开局已满充能，第 2 回合就会释放招牌技；你每花 1 AP 敌人重新充能 +1。用 [1] 誓刃把先锋撞上右侧障碍可附加真伤！护住宝箱通关必得「铭文·碎石震荡」与「遗迹铁壁甲」。Q/E 旋转视角。"
