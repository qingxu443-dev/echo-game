; ECHO - Godot 4.x project
; Initial project skeleton. Gameplay settings will be added in their design phase.

config_version=5

[application]

config/name="ECHO"
config/description="A 2D turn-based tactical roguelite."
run/main_scene="res://scenes/menu/main_menu.tscn"

[display]

[display/window]

size/viewport_width=1280
size/viewport_height=720
handheld/orientation=1
stretch/mode="canvas_items"
stretch/aspect="keep"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
