# Keep shell scripts LF so the shebang works on a fresh clone.
*.sh   text eol=lf
# Windows entry points must stay CRLF.
*.bat  text eol=crlf
*.ps1  text eol=crlf
# GDScript and docs normalise to LF in the repository.
*.gd   text eol=lf
*.md   text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.godot text eol=lf
# Godot rewrites import metadata with LF on Windows as well.
*.import text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
# Binary art assets.
*.webp binary
*.png  binary
*.jpg  binary
*.jpeg binary

# Tool sources and dependency/config locks use stable line endings.
*.py   text eol=lf
*.txt  text eol=lf
*.json text eol=lf
