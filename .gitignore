# Godot 4 generated files
.godot/

# Resource UID sidecar files (*.gd.uid) are tracked on purpose.
# Godot derives them from the res:// path, so they change when a file is
# moved or renamed. Committing them keeps existing uid:// references valid
# for every collaborator. Do not add *.uid to this file.

# Imported assets and editor cache
.import/

# Exported builds
/build/
/dist/
*.apk
*.aab
*.pck

# IDE and operating-system files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Temporary and backup files
*.tmp
*.bak
*~

# Python tool caches
__pycache__/
